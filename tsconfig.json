{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@training-planner/domain": ["packages/domain/src/index.ts"],
      "@training-planner/knowledge": ["packages/knowledge/src/index.ts"],
      "@training-planner/knowledge/canonical": ["packages/knowledge/src/canonical.ts"],
      "@training-planner/golden-fixtures": ["eval/golden-plans/fixture.ts"],
      "@training-planner/planner-core": ["packages/planner-core/src/index.ts"],
      "@training-planner/policy": ["packages/policy/src/index.ts"],
      "@training-planner/i18n": ["packages/i18n/src/index.ts"],
      "@training-planner/narrator": ["packages/narrator/src/index.ts"],
      "@training-planner/entries": ["packages/entries/src/index.ts"],
      "@training-planner/review": ["packages/review/src/index.ts"],
      "@training-planner/storage": ["packages/storage/src/index.ts"],
      "@training-planner/offline": ["packages/offline/src/index.ts"],
      "@training-planner/signals": ["packages/signals/src/index.ts"],
      "@training-planner/triggers": ["packages/triggers/src/index.ts"],
      "@training-planner/replan": ["packages/replan/src/index.ts"],
      "@training-planner/worker": ["packages/worker/src/index.ts"],
      "@training-planner/nudges": ["packages/nudges/src/index.ts"],
      "@training-planner/season": ["packages/season/src/index.ts"],
      "@training-planner/advisor": ["packages/advisor/src/index.ts"],
      "@training-planner/coach": ["packages/coach/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "eval/**/*.ts",
    "vitest.config.ts"
  ]
}

# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
coverage/
*.tsbuildinfo

# local environment and secrets — never commit a key, a token, or a DSN
.env
.env.*
!.env.example
secrets/
*.pem
*.p12

# local data: a real athlete's data never enters the repository, not even a dump
*.sqlite
*.db
/data/
# Anchored on purpose. An unanchored `data/` also matched `docs/data/`, and two design
# documents that seven other files cite were silently never committed while every local
# audit still said "0 dead links", because the files existed on the author's laptop.
fixtures/**/real/**
*.csv
*.tcx
*.fit
*.gpx

# editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# local scratch (page dumps from manual UI passes)
/tmp/

# tooling caches
.eslintcache
.cache/
.turbo/
.next/
.vite/

# knowledge tooling: keep the corpus, ignore scratch
knowledge/**/scratch/
research/**/raw/*.html
